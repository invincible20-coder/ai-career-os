# ── LLM Configuration ──
LLM_PROVIDER=mock
USE_MOCK_LLM=true
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=20.0

# ── Application ──
APP_NAME=Autonomous Job Hunt AI Agent
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
AUTH_COOKIE_SECURE=false

# ── Storage ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_hunt_agent

# ── Job Search ──
MAX_JOBS_PER_SEARCH=10
DEFAULT_COUNTRY=India
REQUEST_TIMEOUT_SECONDS=15.0
STEP_RETRY_ATTEMPTS=3
STEP_RETRY_BASE_DELAY_SECONDS=0.5
STEP_RETRY_MAX_DELAY_SECONDS=4.0
MAX_PARALLEL_JOB_TASKS=4

# ── Behavior Engine ──
BEHAVIOR_MIN_APPLICATIONS=5
BEHAVIOR_ANALYSIS_WINDOW_DAYS=30

# ── Rate Limiting ──
HUNT_RATE_LIMIT_REQUESTS=10
HUNT_RATE_LIMIT_WINDOW_SECONDS=60

# ── Redis / Workers / Observability ──
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
BACKGROUND_WORKER_ENABLED=true
SECURITY_HEADERS_ENABLED=true
CSRF_PROTECTION_ENABLED=true
METRICS_ENABLED=true

# ── OAuth / Identity ──
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/auth/oauth
OAUTH_ENABLED_PROVIDERS=google,github,linkedin,apple,microsoft,discord
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
LINKEDIN_CLIENT_ID=
APPLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
DISCORD_CLIENT_ID=

# ── API Server ──
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
